---
// Class timetable. The live Mindbody schedule comes first, so people can see
// what's on and book. Second: Mindbody's Pricing widget (opened on "Passes &
// packs") so people without a pass can buy one without leaving the page.
// Memberships follow as cards, because they aren't in the Pricing widget yet.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MindbodySchedule from '../components/MindbodySchedule.astro';
import site from '../../content/site.json';
import prices from '../../content/prices.json';
import c from '../../content/timetable.json';

const links = site.links as Record<string, string>;
const { studio } = prices;
const offer = studio.startOffer;
const inc = studio.inclusions as Record<string, string>;
// Each membership's own Mindbody checkout link, or the Mindbody shop until it's set.
const products = site.mindbodyProducts as Record<string, string>;
const joinHref = (id: string) => products[id] || links.memberships;
const p = c.passes;
---
<Base title={c.seo.title} description={c.seo.description} path="/timetable">
  <Nav ctaHref={site.links.studioJoin} ctaLabel={`$${offer.price} trial`} links={[{ href: '/studio', label: 'Studio', mobile: true }, { href: '/mums-and-bubs', label: 'Mums & bubs' }, { href: '/timetable', label: 'Timetable', current: true }]} />

  <main id="main">
    <section class="tt-hero">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.hero.eyebrow}</p>
        <h1 class="display" data-reveal style="--i:1">{c.hero.headline}</h1>
        <p class="lede" data-reveal style="--i:2">{c.hero.sub}</p>
        <div class="tt-hero__links" data-reveal style="--i:3">
          <a class="chip" href="#passes" data-cta="timetable-passes">{c.hero.passesLink} <span aria-hidden="true">↓</span></a>
          <a class="chip chip--ice" href={site.links.studioJoin} data-cta="timetable-trial">{c.hero.trialLink}: ${offer.price} ›</a>
        </div>
      </div>
    </section>

    <section class="section schedule" id="schedule">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2>{c.schedule.headline}</h2>
          <p class="small schedule__note">{c.schedule.note} <a href="#passes">{c.schedule.buyLink} ›</a></p>
        </div>
        <MindbodySchedule widgetId={site.mindbodyWidgetId} fallbackHref={site.links.mindbodySchedule} loading={c.schedule.loading} fallback={c.schedule.fallback} fallbackLink={c.schedule.fallbackLink} />
      </div>
    </section>

    <section class="section section--mist passes" id="passes">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{p.eyebrow}</p>
        <h2 data-reveal style="--i:1">{p.headline}</h2>
        <p class="lede passes__sub" data-reveal style="--i:2">{p.sub}</p>
        <div class="passes__widget">
          <MindbodySchedule type="Pricing" category="passesAndPacks" widgetId={site.mindbodyPricingWidgetId} fallbackHref={links.mindbodyPricing} loading={p.loading} fallback={p.fallback} fallbackLink={p.fallbackLink} />
        </div>

        <h3 class="passes__h" data-reveal>{p.membershipsHeadline}</h3>
        <p class="small passes__note" data-reveal>{p.membershipsNote}</p>
        <div class="mgrid">
          {studio.memberships.map((m, n) => (
            <article class={`mcard ${m.recommended ? 'mcard--featured' : ''}`} data-reveal style={`--i:${n}`}>
              {m.recommended && <p class="mcard__tag">{p.premiumTag}</p>}
              <h4 class="mcard__name">{m.name}</h4>
              <p class="mcard__price"><b>${m.weekly}</b><span>/week</span></p>
              <ul class="mcard__lines">{m.includes.map((k) => <li>{inc[k]}</li>)}</ul>
              <a class={`btn btn--block ${m.recommended ? 'btn--ice' : ''}`} href={joinHref(m.id)} data-cta={`join-${m.id}`}>{p.cta}<span class="vh"> {m.name}</span></a>
            </article>
          ))}
        </div>
        <p class="small passes__trial">{p.trialNote} <a href={site.links.studioJoin} data-cta="passes-trial">{p.trialLink} ›</a></p>
        <p class="small passes__legal">{p.legal}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 data-reveal>{c.info.headline}</h2>
        <div class="grid grid--3 info">
          {c.info.items.map((i, n) => (
            <article class="card" data-reveal style={`--i:${n}`}>
              <h3>{i.title}</h3>
              <p class="small">{i.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .tt-hero { background: var(--navy); color: #fff; padding-block: clamp(2.5rem, 1.75rem + 3vw, 4rem) clamp(1.75rem, 1.25rem + 2vw, 2.5rem); }
  .tt-hero .eyebrow, .tt-hero .lede { color: var(--on-navy-soft); }
  .tt-hero .display { margin-bottom: 0.75rem; }
  .tt-hero .lede { max-width: 38rem; }
  .tt-hero__links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0 1.1rem; border-radius: 999px;
    font-size: 0.95rem; font-weight: 600; text-decoration: none; color: #fff; background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    transition: transform 450ms var(--spring-fast), background-color 160ms var(--ease-out);
  }
  .chip:hover { background: rgba(255, 255, 255, 0.2); }
  .chip:active { transform: scale(0.96); transition-duration: 60ms; }
  .chip--ice { background: var(--ice); color: var(--navy); box-shadow: none; }
  .chip--ice:hover { background: #c6e8ff; }

  .schedule { padding-top: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .schedule .section-head { align-items: baseline; }
  .schedule__note { margin: 0; max-width: 32rem; }
  .schedule__note a, .passes__trial a { color: #2a62d6; font-weight: 600; white-space: nowrap; }

  .passes { scroll-margin-top: var(--nav-h); }
  .passes__sub { max-width: 40rem; }
  .passes__widget { margin-top: 1.75rem; }
  .passes__h { margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) 0 0.25rem; font-size: 1.5rem; }
  .passes__note { margin: 0 0 1rem; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .mgrid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); align-items: stretch; }
  .mcard { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.4rem; border-radius: var(--radius); background: #fff; }
  .mcard--featured { background: var(--navy); color: #fff; }
  .mcard__tag { margin: 0; font-size: 0.8rem; font-weight: 700; color: var(--ice); }
  .mcard__name { margin: 0; font-family: var(--font-promo); font-style: italic; font-weight: 400; text-transform: uppercase; font-size: 1.5rem; line-height: 1.05; }
  .mcard__price { margin: 0.1rem 0 0.4rem; }
  .mcard__price b { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.04em; }
  .mcard__price span { font-size: 0.95rem; color: var(--ink-soft); margin-left: 0.15rem; }
  .mcard--featured .mcard__price span { color: var(--on-navy-soft); }
  .mcard__lines { list-style: none; margin: 0 0 1rem; padding: 0; font-size: 0.9rem; color: var(--ink-soft); display: grid; gap: 0.35rem; }
  .mcard--featured .mcard__lines { color: var(--on-navy-soft); }
  .mcard__lines li { padding-left: 1.3rem; position: relative; }
  .mcard__lines li::before { content: '✓'; position: absolute; left: 0; font-weight: 700; color: #2a62d6; }
  .mcard--featured .mcard__lines li::before { color: var(--ice); }
  .mcard .btn { margin-top: auto; }
  .passes__trial { margin: 1rem 0 0; }
  .passes__legal { margin: 1.25rem 0 0; }

  .info { margin-top: 1.5rem; }
  .info .card { border: 0; }
</style>
