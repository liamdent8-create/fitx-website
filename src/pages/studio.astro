---
// Studio sales page. Section order follows the EBT challenge funnel
// (hook → trust → proof → urgency → value → offer → objections → catch-all).
// See FUNNEL.md for the reasoning behind each section.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Video from '../components/Video.astro';
import Photo from '../components/Photo.astro';
import Carousel from '../components/Carousel.astro';
import Countdown from '../components/Countdown.astro';
import TileSheet from '../components/TileSheet.astro';
import T from '../components/T.astro';
import site from '../../content/site.json';
import prices from '../../content/prices.json';
import videos from '../../content/videos.json';
import faq from '../../content/studio-faq.json';
import testimonials from '../../content/testimonials.json';
import c from '../../content/studio.json';

import neon from '../assets/studio/neon-sign-dumbbells.jpg';
import floorWide from '../assets/studio/gym-floor-wide.jpg';
import floorLand from '../assets/studio/gym-floor-landscape.jpg';
import rack from '../assets/studio/squat-rack.jpg';
import dumbbells from '../assets/studio/dumbbell-rack.jpg';
import dumbbellsHigh from '../assets/studio/dumbbell-rack-high.jpg';
import pilatesRoom from '../assets/studio/pilates-room-mat.jpg';
import pilatesMat from '../assets/studio/pilates-mat-closeup.jpg';
import pilatesWeights from '../assets/studio/pilates-weights.jpg';
import pilatesShelf from '../assets/studio/pilates-shelf.jpg';

const photos: Record<string, ImageMetadata> = {
  'squat-rack': rack,
  'pilates-room-mat': pilatesRoom,
  'gym-floor-wide': floorWide,
  'dumbbell-rack': dumbbells,
  'pilates-weights': pilatesWeights,
};
const included = c.included.items.map((t) => ({ ...t, photo: photos[t.photo] }));

const gallery = [
  { src: floorLand, alt: 'The FIT X Studio gym floor with dumbbell racks, benches and the neon FIT X sign on a mirrored wall' },
  { src: pilatesRoom, alt: 'The bright mat Pilates room with mirrors and a blue FIT X Studio mat' },
  { src: rack, alt: 'Squat rack with a loaded barbell in the strength area' },
  { src: pilatesWeights, alt: 'Pink 1kg hand weights lined up on a timber shelf' },
  { src: dumbbells, alt: 'Rows of hex dumbbells on a rack' },
  { src: pilatesShelf, alt: 'Pink ankle weights and black hand weights on Pilates room shelving' },
  { src: floorWide, alt: 'Dumbbells and benches beneath warm LED lighting' },
  { src: dumbbellsHigh, alt: 'Looking down a full dumbbell rack' },
];

const { studio } = prices;
const offer = studio.startOffer;
const premium = studio.memberships.find((m) => m.id === 'premium')!;
const others = studio.memberships.filter((m) => m.id !== 'premium');
const inc = studio.inclusions as Record<string, string>;
const results = testimonials.items.filter((t: any) => t.arm === 'studio' && t.consent?.given === true && t.result);
const reviews = testimonials.items.filter((t: any) => t.arm === 'studio' && t.consent?.given === true);
const join = site.links.studioJoin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: 'FIT X Studio',
  url: 'https://fitxstudio.com.au/studio',
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: 'AU',
  },
  sameAs: [site.instagram.brand, site.instagram.studio],
};
---
<Base title={c.seo.title} description={c.seo.description} path="/studio">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- 1. Banner: the hook before the page starts -->
  <a class="banner" href={join} data-cta="banner">
    <span class="banner__tag">{c.banner.tag}</span>
    <span class="banner__text">{c.banner.text}</span>
    <span class="banner__link">{c.banner.link} ›</span>
  </a>
  <Nav ctaHref={join} ctaLabel={`$${offer.price} trial`} />

  <main id="main">
    <!-- 2. HOOK: the offer as the prize, outcome headline, one CTA -->
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <Photo src={neon} alt="" ratio="auto" sizes="100vw" eager class="hero__img" />
      </div>
      <div class="wrap hero__content">
        <p class="promo hero__promo" data-reveal>
          <span>{c.hero.promoTop}</span>
          <span class="hero__promo-outline">{c.hero.promoBottom}</span>
        </p>
        <p class="hero__badge" data-reveal style="--i:1"><span>${offer.price}</span> {c.hero.badge.replace(`$${offer.price} · `, '')}</p>
        <h1 class="display" data-reveal style="--i:2"><T text={c.hero.headline} /></h1>
        <p class="lede" data-reveal style="--i:3"><T text={c.hero.sub} /></p>
        <div data-reveal style="--i:4">
          <a class="btn btn--light btn--big" href={join} data-cta="hero">{c.hero.cta} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="hero__trust" data-reveal style="--i:5">
          {c.hero.trust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <!-- 3. Ticker: what's included, for skimmers -->
    <div class="ticker" aria-label="What's included">
      <ul class="ticker__row">{c.ticker.map((t) => <li>{t}</li>)}</ul>
      <ul class="ticker__row" aria-hidden="true">{c.ticker.map((t) => <li>{t}</li>)}</ul>
    </div>

    <!-- 4. TRUST: the VSL, CTA right under it -->
    <section class="section vsl-section">
      <div class="wrap">
        <div class="center">
          <p class="eyebrow" data-reveal>{c.vsl.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.vsl.headline}</h2>
        </div>
        <div class="vsl-wrap" data-reveal style="--i:2">
          <Video video={videos.studio as any} />
          <div class="center"><a class="btn btn--big" href={join} data-cta="video">{c.vsl.cta} <span class="arrow" aria-hidden="true">→</span></a></div>
        </div>
      </div>
    </section>

    <!-- 5. PROOF: member results straight after the video -->
    <section class="section section--mist results">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">{c.results.eyebrow}</p>
            <h2>{c.results.headline}</h2>
          </div>
        </div>
        {results.length > 0 ? (
          <Carousel label="Member results">
            {results.map((r: any) => (
              <figure class="result">
                {r.photoSrc && <img src={r.photoSrc} alt={`${r.name} training at FIT X Studio`} loading="lazy" />}
                <figcaption>
                  <p class="result__big">{r.result}</p>
                  <p class="result__time">{r.timeframe}</p>
                  <blockquote>“{r.quote}”</blockquote>
                  <cite>{r.name}</cite>
                </figcaption>
              </figure>
            ))}
          </Carousel>
        ) : (
          <Carousel label="Member results (coming soon)">
            {[1, 2, 3, 4].map((n) => (
              <figure class="result result--empty">
                <figcaption>
                  <p class="result__big">Result {n}</p>
                  <p class="result__time">e.g. first chin-up · 8 weeks</p>
                  <blockquote>Member quote goes here.</blockquote>
                  <cite>First name</cite>
                </figcaption>
              </figure>
            ))}
          </Carousel>
        )}
        {results.length === 0 && <p class="small" data-reveal><T text={c.results.empty} /></p>}
        <div class="center results__cta" data-reveal><a class="btn btn--big" href={join} data-cta="results">{c.results.cta} <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <!-- 6. URGENCY: real deadline only -->
    <section class="section urgency">
      <div class="narrow center">
        <p class="pill" data-reveal><span>{c.urgency.pill}</span> <i aria-hidden="true"></i> {c.urgency.pillNote}</p>
        <p class="eyebrow urgency__label" data-reveal style="--i:1">{c.urgency.label}</p>
        <p class="promo urgency__date" data-reveal style="--i:1">{c.urgency.date}</p>
        <div data-reveal style="--i:2"><Countdown label={`${c.urgency.label} ${c.urgency.date}`} until="2026-10-26T00:00:00+10:00" /></div>
        <div data-reveal style="--i:3"><a class="btn btn--big" href={join} data-cta="urgency">{c.urgency.cta} <span class="arrow" aria-hidden="true">→</span></a></div>
        <p class="small" data-reveal style="--i:4">{c.urgency.small}</p>
      </div>
    </section>

    <!-- 7. CLARITY: what you're buying -->
    <section class="section section--navy about">
      <div class="narrow center">
        <p class="eyebrow" data-reveal>{c.about.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.about.headline}</h2>
        <p class="lede" data-reveal style="--i:2"><T text={c.about.body} /></p>
      </div>
    </section>

    <!-- 8. VALUE: what's included, Apple tiles with detail sheets -->
    <section class="section">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">{c.included.eyebrow}</p>
            <h2>{c.included.headline}</h2>
          </div>
          <a class="link-more" href={site.links.timetable}>See the timetable</a>
        </div>
        <div data-reveal style="--i:1"><TileSheet id="included" label="What's included" items={included as any} /></div>
      </div>
    </section>

    <!-- 9. OFFER AGAIN: the prize panel -->
    <section class="bonus-section">
      <div class="bonus-section__media" aria-hidden="true">
        <Photo src={floorLand} alt="" ratio="auto" sizes="100vw" class="bonus-section__img" />
      </div>
      <div class="wrap bonus">
        <div>
          <p class="eyebrow" data-reveal>{c.bonus.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.bonus.headline}</h2>
          <ul class="ticks" data-reveal style="--i:2">{c.bonus.items.map((i) => <li>{i}</li>)}</ul>
          <p class="small" data-reveal style="--i:3"><T text={c.bonus.extra} /></p>
        </div>
        <div class="bonus__card glass" data-reveal style="--i:2">
          <p class="promo bonus__price">{c.bonus.price}</p>
          <p class="bonus__note">{c.bonus.priceNote}</p>
          <p class="small">Then Premium ${offer.thenWeekly}/week if you'd like to stay. Your trial weeks count towards your minimum term.</p>
          <a class="btn btn--ice btn--block btn--big" href={join} data-cta="bonus">{c.bonus.cta} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- 10. EFFORT: the app -->
    <section class="section section--mist app">
      <div class="wrap app__grid">
        <div>
          <p class="eyebrow" data-reveal>{c.app.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.app.headline}</h2>
          <p class="lede" data-reveal style="--i:2">{c.app.body}</p>
          <p class="small" data-reveal style="--i:3"><T text={c.app.note} /></p>
        </div>
        <div class="phone" data-reveal style="--i:2" aria-hidden="true">
          <div class="phone__screen">
            <div class="phone__island"></div>
            <p class="phone__h">This week</p>
            <div class="phone__card"><b>Workout A</b><span>Lower body · 45 min</span></div>
            <div class="phone__card"><b>Workout B</b><span>Upper body · 40 min</span></div>
            <div class="phone__card phone__card--muted"><b>Strength class</b><span>Booked · Thu 6am</span></div>
            <p class="phone__soon">App screenshot coming</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 11. RECAP: checklist -->
    <section class="section">
      <div class="narrow center">
        <p class="eyebrow" data-reveal>{c.checklist.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.checklist.headline}</h2>
      </div>
      <ul class="wrap checklist">
        {c.checklist.items.map((i, n) => <li data-reveal style={`--i:${n % 4}`}>{i}</li>)}
      </ul>
    </section>

    <!-- 12. OBJECTION: "will I feel at home here?" — the space -->
    <section class="section section--mist">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">{c.gallery.eyebrow}</p>
            <h2>{c.gallery.headline}</h2>
          </div>
          <a class="link-more" href={site.instagram.studio}>More on Instagram</a>
        </div>
        <div data-reveal style="--i:1">
          <Carousel label="Photos of the studio">
            {gallery.map((g) => (
              <figure class="gallery__item"><Photo src={g.src} alt={g.alt} ratio="3 / 4" sizes="(min-width: 64rem) 33vw, 82vw" /></figure>
            ))}
          </Carousel>
        </div>
      </div>
    </section>

    <!-- 13. PROOF AGAIN: reviews -->
    <section class="section">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">{c.reviews.eyebrow}</p>
            <h2>{c.reviews.headline}</h2>
          </div>
        </div>
        {reviews.length > 0 ? (
          <div class="grid grid--3">
            {reviews.map((t: any, i: number) => (
              <blockquote class="card review" data-reveal style={`--i:${i % 3}`}>
                <p class="review__stars" aria-label="5 stars">★★★★★</p>
                <p>“{t.quote}”</p>
                <cite>{t.name}</cite>
              </blockquote>
            ))}
          </div>
        ) : (
          <p data-reveal><T text={c.reviews.empty} /></p>
        )}
      </div>
    </section>

    <!-- 14. PRICING + partner card -->
    <section class="section section--mist" id="pricing">
      <div class="wrap">
        <div class="center pricing-head">
          <p class="eyebrow" data-reveal>{c.pricing.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.pricing.headline}</h2>
          <p class="lede" data-reveal style="--i:2">{c.pricing.sub}</p>
        </div>
        <div class="plans">
          <article class="plan plan--premium" data-reveal>
            <p class="plan__tag">{c.pricing.premiumTag}</p>
            <h3 class="plan__name">{premium.name}</h3>
            <p class="plan__blurb">{c.pricing.premiumBlurb}</p>
            <p class="plan__price"><b>${premium.weekly}</b>/week</p>
            <ul class="plan__list">{premium.includes.map((k) => <li>{inc[k]}</li>)}</ul>
            <a class="btn btn--ice btn--block btn--big" href={join} data-cta="pricing-premium">{c.pricing.cta}</a>
            <p class="plan__min">{c.pricing.minimum}</p>
          </article>
          {others.map((m, i) => (
            <article class="plan" data-reveal style={`--i:${i + 1}`}>
              <h3 class="plan__name">{m.name}</h3>
              <p class="plan__price"><b>${m.weekly}</b>/week</p>
              <ul class="plan__list">{m.includes.map((k) => <li>{inc[k]}</li>)}</ul>
              <a class="btn btn--ghost btn--block" href={site.links.memberships} data-cta={`pricing-${m.id}`}>{c.pricing.otherCta}</a>
              <p class="plan__min">{c.pricing.minimum}</p>
            </article>
          ))}
        </div>
        <div class="partner card" data-reveal>
          <span class="partner__ribbon">{c.partner.ribbon}</span>
          <h3>{c.partner.headline}</h3>
          <p>{c.partner.body}</p>
          <a class="btn" href={site.links.timetable} data-cta="partner">{c.partner.cta}</a>
        </div>
        <div class="packs" data-reveal>
          <h3>{c.pricing.packsTitle}</h3>
          <ul class="small">
            {studio.casual.map((x) => <li>{x.name}: ${x.price}</li>)}
            {studio.classPacks.map((p) => <li>{p.name}: ${p.price} ({p.note.toLowerCase()})</li>)}
          </ul>
          <p class="small">{c.pricing.packsNote}</p>
        </div>
      </div>
    </section>

    <!-- 15. OBJECTIONS: FAQ -->
    <section class="section">
      <div class="narrow">
        <div class="center">
          <p class="eyebrow" data-reveal>{c.faq.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.faq.headline}</h2>
        </div>
        <div class="faq" data-reveal style="--i:2">
          {faq.items.map((f: any) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq__a"><p><T text={f.a} /></p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 16. CATCH-ALL: get in touch, over a photo -->
    <section class="contact">
      <div class="contact__media" aria-hidden="true">
        <Photo src={pilatesMat} alt="" ratio="auto" sizes="100vw" class="contact__img" />
      </div>
      <div class="wrap contact__grid">
        <div>
          <h2 class="contact__h" data-reveal>{c.contact.headline}</h2>
          <p class="lede" data-reveal style="--i:1">{c.contact.sub}</p>
        </div>
        <div class="contact__card glass" data-reveal style="--i:1">
          <a class="btn btn--light btn--block btn--big" href={site.instagram.studio} data-cta="contact-dm">{c.contact.dm}</a>
          <div class="contact__rows">
            <a href={`tel:${site.phone.replace(/\s/g, '')}`}><span>Call</span>{site.phone}</a>
            <a href={`mailto:${site.email}`}><span>Email</span>{site.email}</a>
            <a href={site.mapsUrl}><span>Visit</span>{site.address.street}, {site.address.suburb}</a>
            <p><span>Parking</span><T text={site.parking} /></p>
          </div>
          <p class="small contact__todo"><T text={c.contact.form} /></p>
        </div>
      </div>
    </section>

    <!-- Brand marquee -->
    <div class="marquee" aria-hidden="true">
      <p class="promo marquee__row"><span>{c.marquee}</span><span>{c.marquee}</span><span>{c.marquee}</span><span>{c.marquee}</span></p>
    </div>

    <!-- FINAL CTA -->
    <section class="section final">
      <div class="narrow center">
        <h2 data-reveal>{c.final.headline}</h2>
        <p class="lede" data-reveal style="--i:1">{c.final.sub}</p>
        <div data-reveal style="--i:2"><a class="btn btn--light btn--big" href={join} data-cta="final">{c.final.cta} <span class="arrow" aria-hidden="true">→</span></a></div>
        <div class="cross" data-reveal style="--i:3">
          <p class="small">{c.final.crossOnline} <a href={site.links.online}>{c.final.crossOnlineLink}</a></p>
          <p class="small">{c.final.crossApparel} <a href={site.links.apparel}>{c.final.crossApparelLink}</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap small">
      <p class="footer__brand">FIT X <span>Studio.</span></p>
      <p>{site.address.street}, {site.address.suburb} {site.address.state} {site.address.postcode} · {site.parking}</p>
      <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.instagram.studio}>Instagram</a></p>
      <p>{site.legalName} · ABN {site.abn} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </div>
  </footer>

  <!-- Mobile dock: floating glass bar once the hero CTA scrolls away -->
  <div class="dock glass" aria-hidden="true" data-dock>
    <div class="dock__text"><strong>${offer.price}</strong> <span>2 weeks unlimited</span></div>
    <a class="btn btn--light" href={join} data-cta="dock" tabindex="-1">Claim</a>
  </div>

  <script>
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const hero = document.querySelector('.hero .btn');
    const end = document.querySelector('.final');
    if (dock && hero && end && 'IntersectionObserver' in window) {
      let heroGone = false, endShown = false;
      const sync = () => {
        const show = heroGone && !endShown && !document.documentElement.classList.contains('sheet-open');
        dock.classList.toggle('is-on', show);
        dock.setAttribute('aria-hidden', String(!show));
        dock.querySelector('a')!.tabIndex = show ? 0 : -1;
      };
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
      new IntersectionObserver(([e]) => { endShown = e.isIntersecting; sync(); }).observe(end);
    }
  </script>
</Base>

<style>
  /* 1. Banner */
  .banner {
    display: flex; align-items: center; justify-content: center; gap: 0.6rem; flex-wrap: nowrap;
    min-height: var(--banner-h); padding: 0.35rem var(--gutter); text-decoration: none;
    background: var(--ice); color: var(--navy); font-size: 0.82rem; font-weight: 600; letter-spacing: -0.005em;
  }
  .banner__tag { border: 1.5px solid currentColor; border-radius: 0.35rem; padding: 0.05rem 0.4rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 800; }
  .banner__text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .banner__link { text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }

  /* 2. Hero */
  .hero {
    position: relative; isolation: isolate; color: var(--on-navy); background: var(--navy); overflow: hidden;
    min-height: calc(100svh - var(--nav-h) - var(--banner-h)); display: grid; align-items: end;
    padding-block: 3rem clamp(2.5rem, 6vh, 4.5rem);
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(.hero__img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 25%; border-radius: 0; }
  .hero__media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(13, 27, 54, 0.15) 0%, rgba(13, 27, 54, 0.55) 40%, rgba(13, 27, 54, 0.97) 82%);
  }
  /* Scroll-driven: the photo eases back as you scroll, where supported */
  @supports (animation-timeline: scroll()) {
    .hero__media :global(.hero__img) { animation: hero-recede linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    @keyframes hero-recede { to { transform: scale(1.12) translateY(4%); opacity: 0.55; } }
  }
  @media (min-width: 64rem) {
    .hero { align-items: center; }
    .hero__media { left: auto; width: 50%; }
    .hero__media::after { background: linear-gradient(90deg, var(--navy) 0%, rgba(13, 27, 54, 0.35) 40%, rgba(13, 27, 54, 0.05) 100%), linear-gradient(0deg, rgba(13, 27, 54, 0.8), transparent 35%); }
  }
  .hero__content { max-width: var(--max); }
