---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Video from '../components/Video.astro';
import Photo from '../components/Photo.astro';
import Carousel from '../components/Carousel.astro';
import Countdown from '../components/Countdown.astro';
import T from '../components/T.astro';
import site from '../../content/site.json';
import prices from '../../content/prices.json';
import videos from '../../content/videos.json';
import faq from '../../content/studio-faq.json';
import testimonials from '../../content/testimonials.json';
import c from '../../content/studio.json';

import neon from '../assets/studio/neon-sign-dumbbells.jpg';
import floorWide from '../assets/studio/gym-floor-wide.jpg';
import floorLand from '../assets/studio/gym-floor-landscape.jpg';
import rack from '../assets/studio/squat-rack.jpg';
import dumbbells from '../assets/studio/dumbbell-rack.jpg';
import dumbbellsHigh from '../assets/studio/dumbbell-rack-high.jpg';
import pilatesRoom from '../assets/studio/pilates-room-mat.jpg';
import pilatesMat from '../assets/studio/pilates-mat-closeup.jpg';
import pilatesWeights from '../assets/studio/pilates-weights.jpg';
import pilatesShelf from '../assets/studio/pilates-shelf.jpg';

const photos: Record<string, ImageMetadata> = {
  'squat-rack': rack,
  'pilates-room-mat': pilatesRoom,
};

const gallery = [
  { src: floorLand, alt: 'The FIT X Studio gym floor with dumbbell racks, benches and the neon FIT X sign on a mirrored wall' },
  { src: rack, alt: 'Squat rack with a loaded barbell in the strength area' },
  { src: pilatesRoom, alt: 'The bright mat Pilates room with mirrors and a blue FIT X Studio mat' },
  { src: dumbbells, alt: 'Rows of hex dumbbells on a rack' },
  { src: pilatesWeights, alt: 'Pink 1kg hand weights lined up on a timber shelf' },
  { src: floorWide, alt: 'Dumbbells and benches beneath warm LED lighting' },
  { src: pilatesShelf, alt: 'Pink ankle weights and black hand weights on Pilates room shelving' },
  { src: dumbbellsHigh, alt: 'Looking down a full dumbbell rack' },
];

const { studio } = prices;
const offer = studio.startOffer;
const premium = studio.memberships.find((m) => m.id === 'premium')!;
const others = studio.memberships.filter((m) => m.id !== 'premium');
const inc = studio.inclusions as Record<string, string>;
const proof = testimonials.items.filter((t: any) => t.arm === 'studio' && t.consent?.given === true);
const join = site.links.studioJoin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: 'FIT X Studio',
  url: 'https://fitxstudio.com.au/studio',
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: 'AU',
  },
  sameAs: [site.instagram.brand, site.instagram.studio],
};
---
<Base title={c.seo.title} description={c.seo.description} path="/studio">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Nav ctaHref={join} ctaLabel={`$${offer.price} trial`} />

  <main id="main">
    <!-- HOOK: full-bleed photo, outcome headline, one offer -->
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <Photo src={neon} alt="" ratio="auto" sizes="100vw" eager class="hero__img" />
      </div>
      <div class="wrap hero__content">
        <p class="eyebrow hero__eyebrow" data-reveal>{c.hero.eyebrow}</p>
        <h1 class="display" data-reveal style="--i:1"><T text={c.hero.headline} /></h1>
        <p class="lede" data-reveal style="--i:2"><T text={c.hero.sub} /></p>
        <div class="hero__ctas" data-reveal style="--i:3">
          <a class="btn btn--light" href={join} data-cta="hero">{c.hero.cta}</a>
          <a class="btn btn--ghost" href="#offer">{c.hero.secondaryCta}</a>
        </div>
        <p class="cta-note small hero__note" data-reveal style="--i:4">{c.hero.note}</p>
        <div data-reveal style="--i:5"><Countdown label={c.countdown.label} until={c.countdown.opensAt} /></div>
      </div>
    </section>

    <!-- What's included, at a glance -->
    <div class="ticker" aria-label="What's included">
      <ul class="ticker__row">
        {c.ticker.map((t) => <li>{t}</li>)}
      </ul>
      <ul class="ticker__row" aria-hidden="true">
        {c.ticker.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <!-- VSL with the CTA right under it -->
    <section class="section section--navy vsl-section">
      <div class="narrow center">
        <p class="eyebrow" data-reveal>{c.vsl.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.vsl.headline}</h2>
      </div>
      <div class="wrap vsl-wrap" data-reveal style="--i:2">
        <Video video={videos.studio as any} />
        <div class="center"><a class="btn btn--light" href={join} data-cta="video">{c.vsl.cta}</a></div>
      </div>
    </section>

    <!-- Where you end up -->
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.outcomes.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.outcomes.headline}</h2>
        <div class="grid grid--2 moments">
          {c.outcomes.items.map((m, i) => (
            <article class="moment" data-reveal style={`--i:${i % 2}`}>
              <h3><T text={m.title} /></h3>
              <p><T text={m.body} /></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- The space -->
    <section class="section section--mist gallery">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.gallery.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.gallery.headline}</h2>
        <div data-reveal style="--i:2">
          <Carousel label="Photos of the studio">
            {gallery.map((g) => (
              <figure class="gallery__item"><Photo src={g.src} alt={g.alt} ratio="4 / 5" sizes="(min-width: 64rem) 33vw, 82vw" /></figure>
            ))}
          </Carousel>
        </div>
      </div>
    </section>

    <!-- STORY -->
    <section class="section story-section">
      <div class="wrap story">
        <div class="story__photo" data-reveal>
          <Photo alt="Coach Loz coaching a member at the squat rack" shot="Lauren coaching a member at the squat rack" />
        </div>
        <div>
          <p class="eyebrow" data-reveal>{c.story.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.story.headline}</h2>
          <p class="lede" data-reveal style="--i:2"><T text={c.story.body} /></p>
          <p class="small" data-reveal style="--i:3">— {c.story.signoff}</p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section section--mist">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.steps.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.steps.headline}</h2>
        <ol class="steps grid grid--3">
          {c.steps.items.map((s, i) => (
            <li class="card" data-reveal style={`--i:${i}`}>
              <span class="steps__n">{i + 1}</span>
              <h3><T text={s.title} /></h3>
              <p><T text={s.body} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- OFFER / VALUE STACK on a photo, with a glass price card -->
    <section class="offer-section" id="offer">
      <div class="offer-section__media" aria-hidden="true">
        <Photo src={floorLand} alt="" ratio="auto" sizes="100vw" class="offer-section__img" />
      </div>
      <div class="wrap offer">
        <div>
          <p class="eyebrow" data-reveal>{c.offer.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.offer.headline}</h2>
          <p class="lede" data-reveal style="--i:2">{c.offer.sub}</p>
          <ul class="stack">
            {premium.includes.map((k, i) => <li data-reveal style={`--i:${Math.min(i, 6)}`}>{inc[k]}</li>)}
          </ul>
        </div>
        <div class="price glass" data-reveal style="--i:2">
          <p class="eyebrow">{c.offer.cardEyebrow}</p>
          <p class="price__big"><span>${offer.price}</span> {offer.name}</p>
          <hr />
          <p class="price__then">{c.offer.cardThen}: <strong>${offer.thenWeekly}/week</strong></p>
          <ul class="price__terms small">
            {c.offer.terms.map((t) => <li>{t}</li>)}
          </ul>
          <a class="btn btn--light btn--block" href={join} data-cta="offer">{c.offer.cta}</a>
          <p class="small price__why">{c.offer.footnote}</p>
        </div>
      </div>
    </section>

    <!-- CLASSES -->
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.classes.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.classes.headline}</h2>
        <div class="grid grid--2 classes">
          {c.classes.items.map((k, i) => (
            <article class="card class-card" data-reveal style={`--i:${i % 2}`}>
              <Photo src={photos[k.photo]} alt={`${k.title} at FIT X Studio`} shot={`${k.title} class with members`} ratio="3 / 2" sizes="(min-width: 48rem) 50vw, 100vw" />
              <div class="class-card__body">
                <h3><T text={k.title} /></h3>
                <p><T text={k.body} /></p>
              </div>
            </article>
          ))}
        </div>
        <p class="small classes__more" data-reveal>
          {c.classes.more} <a href={site.links.timetable}>See the timetable on Mindbody</a>.
        </p>
      </div>
    </section>

    <!-- PROOF WALL: only consented testimonials render -->
    <section class="section section--mist">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.proof.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.proof.headline}</h2>
        {proof.length > 0 ? (
          <div class="grid grid--3">
            {proof.map((t: any, i: number) => (
              <blockquote class="card quote" data-reveal style={`--i:${i % 3}`}>
                <p>“{t.quote}”</p>
                {t.result && <p class="small">{t.result}{t.timeframe ? ` · ${t.timeframe}` : ''}</p>}
                <cite>{t.name}</cite>
              </blockquote>
            ))}
          </div>
        ) : (
          <p data-reveal><mark class="todo">[[NEEDS LAUREN: studio testimonials with written consent: Google reviews, member quotes or video. Open day feedback would work well here.]]</mark></p>
        )}
      </div>
    </section>

    <!-- OTHER OPTIONS -->
    <section class="section">
      <div class="wrap">
        <p class="eyebrow" data-reveal>{c.others.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.others.headline}</h2>
        <p class="lede" data-reveal style="--i:2">{c.others.sub}</p>
        <div class="grid grid--3 tiers">
          {others.map((m, i) => (
            <article class="card tier" data-reveal style={`--i:${i}`}>
              <h3>{m.name}</h3>
              <p class="tier__price"><strong>${m.weekly}</strong>/week</p>
              <ul class="small">{m.includes.map((k) => <li>{inc[k]}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="packs" data-reveal>
          <h3>{c.others.packsTitle}</h3>
          <ul class="small">
            {studio.casual.map((x) => <li>{x.name}: ${x.price}</li>)}
            {studio.classPacks.map((p) => <li>{p.name}: ${p.price} ({p.note.toLowerCase()})</li>)}
          </ul>
          <p class="small">{c.others.packsNote}</p>
          <a class="btn btn--ghost" href={site.links.memberships} data-cta="other-options">{c.others.cta}</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--mist">
      <div class="narrow">
        <p class="eyebrow" data-reveal>{c.faq.eyebrow}</p>
        <h2 data-reveal style="--i:1">{c.faq.headline}</h2>
        <div class="faq" data-reveal style="--i:2">
          {faq.items.map((f: any) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq__a"><p><T text={f.a} /></p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- LOCATION -->
    <section class="section">
      <div class="wrap grid grid--2 location">
        <div>
          <p class="eyebrow" data-reveal>{c.location.eyebrow}</p>
          <h2 data-reveal style="--i:1">{c.location.headline}</h2>
          <address data-reveal style="--i:2">
            FIT X Studio<br />
            {site.address.street}<br />
            {site.address.suburb} {site.address.state} {site.address.postcode}
          </address>
          <p class="small" data-reveal style="--i:3"><T text={site.parking} /></p>
          <p data-reveal style="--i:3"><a href={site.mapsUrl}>Open in Google Maps</a></p>
        </div>
        <div data-reveal style="--i:1">
          <Photo src={pilatesRoom} alt="The mat Pilates room at FIT X Studio, Manunda" ratio="4 / 3" sizes="(min-width: 48rem) 50vw, 100vw" />
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final">
      <div class="final__media" aria-hidden="true">
        <Photo src={pilatesMat} alt="" ratio="auto" sizes="100vw" class="final__img" />
      </div>
      <div class="narrow final__content">
        <h2 data-reveal>{c.final.headline}</h2>
        <p class="lede" data-reveal style="--i:1">{c.final.sub}</p>
        <div data-reveal style="--i:2"><a class="btn btn--light" href={join} data-cta="final">{c.final.cta}</a></div>
        <div class="cross glass" data-reveal style="--i:3">
          <p class="small">{c.final.crossOnline} <a href={site.links.online}>{c.final.crossOnlineLink}</a></p>
          <p class="small">{c.final.crossApparel} <a href={site.links.apparel}>{c.final.crossApparelLink}</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner small">
      <p>{site.legalName} · ABN {site.abn}</p>
      <p>{site.address.street}, {site.address.suburb} {site.address.state} {site.address.postcode} · <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><a href={site.instagram.studio}>Instagram</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </div>
  </footer>

  <!-- Mobile dock: a floating glass bar that appears once the hero CTA scrolls away -->
  <div class="dock glass" aria-hidden="true" data-dock>
    <div class="dock__text"><strong>${offer.price}</strong> <span>2 weeks unlimited</span></div>
    <a class="btn btn--light" href={join} data-cta="dock" tabindex="-1">Start</a>
  </div>

  <script>
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    const hero = document.querySelector('.hero__ctas');
    const end = document.querySelector('.final');
    if (dock && hero && end && 'IntersectionObserver' in window) {
      let heroGone = false, endShown = false;
      const sync = () => {
        const show = heroGone && !endShown;
        dock.classList.toggle('is-on', show);
        dock.setAttribute('aria-hidden', String(!show));
        dock.querySelector('a')!.tabIndex = show ? 0 : -1;
      };
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(hero);
      new IntersectionObserver(([e]) => { endShown = e.isIntersecting; sync(); }).observe(end);
    }
  </script>
</Base>

<style>
  .center { text-align: center; }

  /* Hero: photo under a navy scrim, content on top */
  .hero {
    position: relative; isolation: isolate; color: var(--on-navy); background: var(--navy);
    min-height: min(100svh - var(--nav-h), 56rem); display: grid; align-items: end;
    padding-block: clamp(6rem, 10vh, 9rem) clamp(2.5rem, 6vh, 5rem);
    overflow: hidden;
  }
  .hero__media, .offer-section__media, .final__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(.hero__img), .offer-section__media :global(.offer-section__img), .final__media :global(.final__img) {
    width: 100%; height: 100%; object-fit: cover; border-radius: 0;
  }
  .hero__media :global(.hero__img) { object-position: 62% 30%; }
  .hero__media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(13, 27, 54, 0.35) 0%, rgba(13, 27, 54, 0.55) 45%, rgba(13, 27, 54, 0.96) 100%),
      linear-gradient(90deg, rgba(13, 27, 54, 0.75) 0%, rgba(13, 27, 54, 0) 70%);
  }
  /* Desktop: the portrait photo sits as a panel on the right and fades into the navy */
  @media (min-width: 64rem) {
    .hero__media { left: auto; width: 48%; }
    .hero__media :global(.hero__img) { object-position: 50% 35%; }
    .hero__media::after {
      background:
        linear-gradient(90deg, var(--navy) 0%, rgba(13, 27, 54, 0.35) 40%, rgba(13, 27, 54, 0.1) 100%),
        linear-gradient(0deg, rgba(13, 27, 54, 0.85) 0%, transparent 35%);
    }
    .hero { align-items: center; }
  }
  .hero__content { max-width: var(--max); }
  .hero .display { max-width: 13ch; margin-bottom: 1.25rem; }
  .hero .lede { max-width: 38rem; color: rgba(255, 255, 255, 0.86); }
  .hero__eyebrow { color: rgba(255, 255, 255, 0.8); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__note { color: rgba(255, 255, 255, 0.75); margin-bottom: 1.5rem; }

  /* Ticker: slow, continuous, pauses on hover and for reduced motion */
  .ticker {
    display: flex; overflow: hidden; background: var(--navy-2); color: var(--on-navy);
    border-block: 1px solid rgba(255, 255, 255, 0.08);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .ticker__row {
    display: flex; flex: none; gap: 2.5rem; padding: 0.95rem 1.25rem; margin: 0; list-style: none;
    animation: ticker 40s linear infinite;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap;
  }
  .ticker__row li::before { content: '✦'; margin-right: 2.5rem; color: #9db8ff; }
  .ticker:hover .ticker__row { animation-play-state: paused; }
  @keyframes ticker { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .ticker { overflow-x: auto; }
    .ticker__row { animation: none; }
    .ticker__row[aria-hidden] { display: none; }
  }

  .vsl-section h2 { margin-bottom: 2rem; }
  .vsl-wrap { max-width: 60rem; display: grid; gap: 1.5rem; }

  .moments { margin-top: 2.5rem; gap: 2rem 3rem; }
  .moment { border-top: 2px solid var(--navy); padding-top: 1.25rem; }
  .moment p { color: var(--ink-soft); margin: 0; }

  .gallery h2 { margin-bottom: 2rem; }
  .gallery__item { margin: 0; }
  .gallery__item :global(.photo) { border-radius: var(--radius); }

  .story { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 48rem) { .story { grid-template-columns: 0.8fr 1fr; gap: 4rem; } }

  .steps { list-style: none; padding: 0; margin: 2rem 0 0; }
  .steps__n {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: var(--navy); color: var(--on-navy); font-weight: 800; margin-bottom: 1rem;
  }
  .steps p { color: var(--ink-soft); margin: 0; }

  /* Offer on a photo */
  .offer-section {
    position: relative; isolation: isolate; overflow: hidden; color: var(--on-navy); background: var(--navy);
    padding-block: clamp(4rem, 2rem + 7vw, 8rem);
  }
  .offer-section__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(13, 27, 54, 0.95) 30%, rgba(13, 27, 54, 0.7)); }
  .offer-section .lede { color: var(--on-navy-soft); }
  .offer-section .eyebrow { color: var(--on-navy-soft); }
  .offer { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 64rem) { .offer { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
  .stack { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.6rem; }
  .stack li { display: flex; gap: 0.75rem; align-items: baseline; font-weight: 600; }
  .stack li::before { content: '✓'; flex: none; font-weight: 900; color: #9db8ff; }
  .price { padding: 2rem; border-radius: calc(var(--radius) + 0.5rem); color: var(--on-navy); }
  .price .eyebrow { color: var(--on-navy-soft); }
  .price__big { margin: 0; font-weight: 700; font-size: 1.05rem; }
  .price__big span { display: block; font-size: clamp(3.5rem, 2.5rem + 4vw, 5rem); letter-spacing: -0.045em; font-weight: 900; line-height: 1; margin-bottom: 0.35rem; }
  .price hr { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.18); margin: 1.25rem 0; }
  .price__then { font-size: 1.1rem; margin: 0 0 0.75rem; }
  .price__terms { padding-left: 1.1rem; margin: 0 0 1.5rem; display: grid; gap: 0.3rem; color: var(--on-navy-soft); }
  .price__why { margin: 1rem 0 0; color: var(--on-navy-soft); }

  .classes { margin-top: 2rem; }
  .class-card { padding: 0.75rem; overflow: hidden; transition: transform 500ms var(--spring-fast), box-shadow 300ms var(--ease-out); }
  @media (hover: hover) { .class-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -28px rgba(13, 27, 54, 0.45); } }
  .class-card :global(.photo) { border-radius: var(--radius-sm); }
  .class-card__body { padding: 1rem 0.5rem 0.5rem; }
  .class-card p { color: var(--ink-soft); margin: 0; }
  .classes__more { margin-top: 1.5rem; }

  .quote { margin: 0; }
  .quote cite { font-style: normal; font-weight: 700; }

  .tiers { margin-top: 1.5rem; }
  .tier__price { font-size: 1.1rem; }
  .tier__price strong { font-size: 2rem; letter-spacing: -0.03em; }
  .tier ul, .packs ul { padding-left: 1.1rem; margin: 0; display: grid; gap: 0.25rem; }
  .packs { margin-top: 2.5rem; display: grid; gap: 0.75rem; justify-items: start; }

  .faq { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
