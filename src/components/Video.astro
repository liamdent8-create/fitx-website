---
// Lightweight VSL player. Shows a poster + play button and only loads the
// video host when tapped (fast on 4G, no third-party cookies until play).
// With no id set, it shows a branded "VSL coming" placeholder.
interface Props {
  video: { provider: 'youtube' | 'bunny' | 'mp4'; id: string; title: string; poster?: string };
}
const { video } = Astro.props;
const ready = Boolean(video.id);

let src = '';
if (video.provider === 'youtube') {
  src = `https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&cc_load_policy=1`;
} else if (video.provider === 'bunny') {
  // id format: "<libraryId>/<videoId>"
  src = `https://iframe.mediadelivery.net/embed/${video.id}?autoplay=true&preload=false`;
}
const poster = video.poster || (video.provider === 'youtube' && video.id ? `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg` : '');
---
<figure class="vsl" data-ready={ready ? 'true' : 'false'}>
  {ready ? (
    video.provider === 'mp4' ? (
      <video controls preload="none" playsinline poster={poster || undefined} title={video.title}>
        <source src={video.id} type="video/mp4" />
      </video>
    ) : (
      <button class="vsl__play" type="button" data-src={src} aria-label={`Play video: ${video.title}`}>
        {poster && <img src={poster} alt="" loading="lazy" decoding="async" />}
        <span class="vsl__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        </span>
      </button>
    )
  ) : (
    <div class="vsl__soon" role="img" aria-label="Video coming soon">
      <span class="vsl__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </span>
      <span class="vsl__label">VSL coming</span>
      <span class="vsl__title">{video.title}</span>
    </div>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vsl__play').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.src!;
      iframe.title = btn.getAttribute('aria-label')!.replace('Play video: ', '');
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .vsl {
    margin: 0; position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius);
    overflow: hidden; background: var(--navy-2); color: var(--on-navy);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .vsl :global(iframe), .vsl video, .vsl__play, .vsl__soon { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vsl__play { padding: 0; cursor: pointer; background: transparent; color: inherit; }
  .vsl__play img { width: 100%; height: 100%; object-fit: cover; }
  .vsl__icon {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 50%;
    background: rgba(255, 255, 255, 0.18); color: #fff;
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: transform 160ms var(--ease-out);
  }
  .vsl__play:active .vsl__icon { transform: scale(0.94); transition-duration: 60ms; }
  .vsl__soon {
    display: grid; place-content: center; text-align: center; gap: 0.35rem;
    background:
      radial-gradient(120% 90% at 20% 10%, rgba(91, 140, 255, 0.28), transparent 60%),
      linear-gradient(160deg, var(--navy-2), var(--navy));
  }
  .vsl__soon .vsl__icon { position: static; translate: none; margin: 0 auto 0.75rem; }
  .vsl__label { font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.8rem; }
  .vsl__title { color: var(--on-navy-soft); font-size: 0.95rem; }
  @media (prefers-reduced-transparency: reduce) {
    .vsl__icon { background: rgba(13, 27, 54, 0.9); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
</style>
