---
// Renders a content string, highlighting any [[NEEDS LAUREN: …]] placeholder
// so unconfirmed copy is obvious in preview. On the live site placeholders are
// left out (see src/lib/todo.ts).
import { hideTodos } from '../lib/todo';
interface Props { text: string }
const parts = Astro.props.text.split(/(\[\[NEEDS LAUREN:[^\]]*\]\])/g).filter(Boolean);
---
{parts.map((p) => (p.startsWith('[[NEEDS') ? (hideTodos ? null : <mark class="todo">{p}</mark>) : p))}
