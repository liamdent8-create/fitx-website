---
// Apple-style tiles in a carousel. Each tile has a round + that opens a detail
// sheet. The sheet grows out of the tile you tapped and returns to it on close
// (same path both ways). On phones it's a bottom sheet you can drag: it tracks
// your finger 1:1, rubber-bands upward, and uses release velocity to decide
// whether to dismiss. Any animation can be grabbed mid-flight.
import Carousel from './Carousel.astro';
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Item { label: string; title: string; detail: string; tone?: string; photo?: ImageMetadata }
interface Props { items: Item[]; label: string; id: string }
const { items, label, id } = Astro.props;
---
<div class="tilesheet" data-tilesheet={id}>
  <Carousel label={label}>
    {items.map((t, i) => (
      <article class={`tile tile--${t.tone ?? 'light'}`}>
        <div class="tile__text">
          <p class="tile__label">{t.label}</p>
          <h3 class="tile__title">{t.title}</h3>
        </div>
        {t.photo ? (
          <Photo src={t.photo} alt="" ratio="auto" sizes="(min-width: 64rem) 33vw, 82vw" class="tile__img" />
        ) : (
          <div class="tile__shot" aria-hidden="true">Shot needed: {t.label.toLowerCase()}</div>
        )}
        <button type="button" class="tile__plus" data-open={i} aria-haspopup="dialog" aria-label={`More about ${t.label}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
        <template data-detail={i}>
          <p class="sheet__label">{t.label}</p>
          <h3 class="sheet__title">{t.title}</h3>
          <p class="sheet__body">{t.detail}</p>
        </template>
      </article>
    ))}
  </Carousel>

  <dialog class="sheet" aria-labelledby={`${id}-title`}>
    <div class="sheet__panel" data-panel>
      <div class="sheet__grab" data-grab aria-hidden="true"><span></span></div>
      <button type="button" class="sheet__close" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
      <div class="sheet__content" data-content id={`${id}-title`}></div>
    </div>
  </dialog>
</div>

<script>
  // Critically damped spring curve (damping 1.0), same as --spring in CSS.
  const SPRING = 'linear(0, 0.067, 0.205, 0.358, 0.499, 0.619, 0.715, 0.79, 0.848, 0.89, 0.921, 0.944, 0.96, 0.972, 0.981, 0.986, 0.991, 0.993, 0.995, 0.997, 0.998, 0.999, 0.999, 0.999, 1)';
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isPhone = () => matchMedia('(max-width: 47.99rem)').matches;

  // Apple's momentum projection (Designing Fluid Interfaces)
  const project = (v: number, d = 0.998) => ((v / 1000) * d) / (1 - d);
  const rubberband = (o: number, dim: number, c = 0.55) => (o * dim * c) / (dim + c * Math.abs(o));

  document.querySelectorAll<HTMLElement>('[data-tilesheet]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const content = root.querySelector<HTMLElement>('[data-content]')!;
    const grab = root.querySelector<HTMLElement>('[data-grab]')!;
    let origin: HTMLElement | null = null;
    let anim: Animation | null = null;

    // Live on-screen transform, so a new animation starts where the eye sees it.
    const currentTransform = () => getComputedStyle(panel).transform === 'none' ? 'none' : getComputedStyle(panel).transform;

    const fromTile = () => {
      if (!origin) return 'translateY(100%)';
      const t = origin.closest('.tile')!.getBoundingClientRect();
      const p = panel.getBoundingClientRect();
      const sx = t.width / p.width, sy = t.height / p.height;
      const dx = t.left + t.width / 2 - (p.left + p.width / 2);
      const dy = t.top + t.height / 2 - (p.top + p.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
    };

    const run = (from: string, to: string, opacity: [number, number], ms: number) => {
      const start = currentTransform();
      anim?.cancel();
      anim = panel.animate(
        [{ transform: start !== 'none' && start !== to ? start : from, opacity: opacity[0] }, { transform: to, opacity: opacity[1] }],
        { duration: reduce() ? 180 : ms, easing: reduce() ? 'ease' : SPRING, fill: 'forwards' }
      );
      return anim.finished.catch(() => {});
    };

    const open = (btn: HTMLElement) => {
      origin = btn;
      const tpl = btn.parentElement!.querySelector<HTMLTemplateElement>('template')!;
      content.replaceChildren(tpl.content.cloneNode(true));
      dialog.showModal();
      document.documentElement.classList.add('sheet-open');
      if (reduce()) { run('none', 'none', [0, 1], 180); return; }
      run(isPhone() ? 'translateY(100%)' : fromTile(), 'none', [0.4, 1], 650);
    };

    const close = async (velocity = 0) => {
      const to = isPhone() ? 'translateY(105%)' : fromTile();
      const ms = isPhone() && velocity > 0 ? Math.max(260, 520 - velocity / 6) : 520;
      dialog.classList.add('is-closing');
      await run('none', reduce() ? 'none' : to, [1, reduce() ? 0 : 0.2], ms);
      dialog.classList.remove('is-closing');
      dialog.close();
      anim?.cancel(); anim = null;
      document.documentElement.classList.remove('sheet-open');
      origin?.focus();
    };

    root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b)));
    root.querySelector('[data-close]')!.addEventListener('click', () => close());
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });

    // Drag to dismiss (phone sheet): 1:1 tracking, velocity history, projection.
    let startY = 0, lastY = 0, baseY = 0, dragging = false;
    let hist: { y: number; t: number }[] = [];
    const translateY = () => { const m = new DOMMatrixReadOnly(getComputedStyle(panel).transform); return m.m42; };

    grab.parentElement!.addEventListener('pointerdown', (e) => {
      if (!isPhone() || !(e.target as HTMLElement).closest('[data-grab], .sheet__panel') || (e.target as HTMLElement).closest('button')) return;
      if (content.contains(e.target as Node) && content.scrollTop > 0) return;
      baseY = translateY();            // grab mid-flight from where it really is
      anim?.cancel(); anim = null;
      panel.style.transform = `translateY(${baseY}px)`;
      dragging = true; startY = lastY = e.clientY; hist = [{ y: e.clientY, t: e.timeStamp }];
      panel.setPointerCapture(e.pointerId);
    });
    panel.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      lastY = e.clientY;
      let y = baseY + (lastY - startY);
      if (y < 0) y = rubberband(y, panel.offsetHeight);   // soft boundary at the top
      panel.style.transform = `translateY(${y}px)`;
      hist.push({ y: e.clientY, t: e.timeStamp }); if (hist.length > 6) hist.shift();
    });
    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      const a = hist[0], b = hist[hist.length - 1];
      const v = b && a && b.t > a.t ? ((b.y - a.y) / (b.t - a.t)) * 1000 : 0;  // px/s
      const y = translateY();
      const projected = y + project(v);
      panel.style.transform = '';
      if (projected > panel.offsetHeight * 0.4 || v > 900) {
        close(v);
      } else {
        anim = panel.animate([{ transform: `translateY(${y}px)` }, { transform: 'none' }], { duration: 520, easing: SPRING, fill: 'forwards' });
      }
    };
    panel.addEventListener('pointerup', release);
    panel.addEventListener('pointercancel', release);
  });
</script>

<style>
  .tile {
    position: relative; overflow: hidden; border-radius: var(--radius);
    aspect-ratio: 3 / 4; min-height: 26rem; display: flex; flex-direction: column;
    background: var(--tile); color: var(--ink);
    transition: transform 500ms var(--spring-fast);
  }
  .tile--dark { background: #0b1222; color: #fff; }
  :global(.section--mist) .tile--light { background: var(--paper); }
  .tile__text { position: relative; z-index: 2; padding: 1.6rem 1.6rem 0; }
  .tile__label { margin: 0 0 0.35rem; font-size: 0.85rem; font-weight: 600; opacity: 0.85; }
  .tile__title { margin: 0; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem); line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; max-width: 16ch; }
  .tile :global(.tile__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 0; z-index: 0; }
  .tile--dark::after, .tile--light:has(.tile__img)::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .tile--dark:has(.tile__img)::after { background: linear-gradient(180deg, rgba(5, 10, 22, 0.78) 0%, rgba(5, 10, 22, 0.15) 45%, rgba(5, 10, 22, 0.35) 100%); }
  .tile--light:has(.tile__img)::after { background: linear-gradient(180deg, rgba(245, 245, 247, 0.92) 0%, rgba(245, 245, 247, 0.2) 40%, transparent 60%); }
  .tile__shot {
    margin: auto 1.25rem 4.5rem; padding: 1rem; border-radius: var(--radius-sm); text-align: center; font-size: 0.85rem; font-weight: 600;
    border: 1px dashed currentColor; opacity: 0.55;
  }
  .tile__plus {
    position: absolute; right: 1rem; bottom: 1rem; z-index: 3;
    width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center;
    border: 0; cursor: pointer; background: rgba(29, 29, 31, 0.86); color: #fff;
    transition: transform 450ms var(--spring-fast), background-color 160ms var(--ease-out);
  }
  .tile--dark .tile__plus { background: rgba(255, 255, 255, 0.92); color: #1d1d1f; }
  .tile__plus:hover { transform: scale(1.08); }
  .tile__plus:active { transform: scale(0.9); transition-duration: 60ms; }
  /* Tap the tile anywhere = tap the + */
  .tile__plus::before { content: ''; position: absolute; inset: -40rem; }

  .sheet {
    padding: 0; border: 0; background: transparent; max-width: none; max-height: none;
    width: 100%; height: 100%; margin: 0; overflow: hidden;
  }
  .sheet::backdrop { background: rgba(5, 10, 22, 0.45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fade-in 300ms var(--ease-out); }
  .sheet.is-closing::backdrop { animation: fade-out 400ms var(--ease-out) forwards; }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
  .sheet__panel {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: min(42rem, 100% - 3rem); max-height: min(80vh, 44rem); overflow: auto;
    background: rgba(255, 255, 255, 0.86); color: var(--ink);
    -webkit-backdrop-filter: blur(30px) saturate(180%); backdrop-filter: blur(30px) saturate(180%);
    border-radius: calc(var(--radius) + 0.25rem); padding: 3rem 2.5rem 2.5rem;
    box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.55);
    transform-origin: center; will-change: transform;
  }
  .sheet__grab { display: none; }
  .sheet__close {
    position: absolute; top: 1rem; right: 1rem; width: 2.25rem; height: 2.25rem; border-radius: 50%; border: 0;
    display: grid; place-items: center; background: rgba(13, 27, 54, 0.08); color: var(--ink); cursor: pointer;
    transition: transform 450ms var(--spring-fast);
  }
  .sheet__close:active { transform: scale(0.9); transition-duration: 60ms; }
  .sheet__content :global(.sheet__label) { margin: 0 0 0.4rem; font-weight: 600; color: var(--ink-soft); }
  .sheet__content :global(.sheet__title) { font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.5rem); letter-spacing: -0.03em; line-height: 1.08; margin: 0 0 1rem; }
  .sheet__content :global(.sheet__body) { font-size: 1.1rem; line-height: 1.55; color: var(--ink-soft); margin: 0; }

  @media (max-width: 47.99rem) {
    .sheet__panel {
      left: 0; right: 0; top: auto; bottom: 0; translate: none; width: 100%;
      max-height: 85vh; border-radius: 1.5rem 1.5rem 0 0; padding: 0.75rem 1.5rem calc(2rem + env(safe-area-inset-bottom));
      touch-action: none;
    }
    .sheet__grab { display: grid; place-items: center; padding: 0.25rem 0 1.25rem; cursor: grab; }
    .sheet__grab span { width: 2.5rem; height: 0.3rem; border-radius: 99px; background: rgba(13, 27, 54, 0.22); }
  }
  @media (prefers-reduced-transparency: reduce) { .sheet__panel { background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; } }
  :global(html.sheet-open) { overflow: hidden; }
</style>
