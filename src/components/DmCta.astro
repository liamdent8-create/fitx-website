---
// "DM us LIFT" — hands people who aren't ready to buy to the ManyChat flow
// (it asks their goal and experience, then walks them through the offer).
import site from '../../content/site.json';
interface Props { tone?: 'light' | 'dark'; lead?: string }
const { tone = 'light', lead = 'Not sure yet?' } = Astro.props;
const dm = site.dm;
---
<a class={`dm dm--${tone}`} href={`https://ig.me/m/${dm.account}`} data-cta="dm">
  <span class="dm__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 3C7 3 3 6.6 3 11.1c0 2.5 1.3 4.8 3.4 6.3L6 21l3.6-2c.8.2 1.6.3 2.4.3 5 0 9-3.6 9-8.1S17 3 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
  </span>
  <span>{lead} DM us <b>{dm.keyword}</b> on Instagram</span>
</a>

<style>
  .dm {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1rem 0.55rem 0.6rem; border-radius: 99px;
    text-decoration: none; font-size: 0.92rem; font-weight: 500;
    transition: transform 450ms var(--spring-fast), background-color 160ms var(--ease-out);
  }
  .dm:active { transform: scale(0.97); transition-duration: 60ms; }
  .dm b { font-family: var(--font-promo); font-style: italic; font-weight: 400; font-size: 1.1em; letter-spacing: 0.04em; }
  .dm__icon { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; }
  .dm--light { background: rgba(255, 255, 255, 0.12); color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); }
  .dm--light:hover { background: rgba(255, 255, 255, 0.2); }
  .dm--light .dm__icon { background: rgba(255, 255, 255, 0.16); }
  .dm--dark { background: var(--mist); color: var(--ink); border: 1px solid var(--line); }
  .dm--dark:hover { background: #ebedf2; }
  .dm--dark .dm__icon { background: var(--navy); color: #fff; }
</style>
